{
  "updated": "2026-06-06",
  "protocol": "nDCG@10 retained per byte, mean over three BEIR corpora (scifact, nfcorpus, arguana). '% of float' is nDCG@10 relative to the uncompressed embedding; '±' is the standard deviation across the corpora. Every row is reproducible with `bitbudget run --embedder <name> --corpus scifact nfcorpus arguana`.",
  "methods": {
    "float32": {
      "axis": "none",
      "desc": "The uncompressed embedding stored as 32-bit floats (4 bytes per dimension). The baseline every other method is measured against."
    },
    "int8": {
      "axis": "quantisation",
      "desc": "Each coordinate linearly scaled to an 8-bit integer (1 byte per dimension). A 4x shrink that is essentially lossless."
    },
    "binary": {
      "axis": "quantisation",
      "desc": "Each coordinate replaced by its sign, one bit per dimension (32x smaller than float). Candidates ranked by Hamming distance."
    },
    "binary+rerank": {
      "axis": "quantisation",
      "desc": "Binary Hamming search shortlists candidates, then the shortlist is re-scored with full-precision vectors. Recovers float-level quality while searching at the binary footprint."
    },
    "pq": {
      "axis": "quantisation",
      "desc": "Product Quantisation: split the vector into sub-vectors and encode each against a learned codebook, a few bytes per vector (Jegou et al., 2011)."
    },
    "rabitq": {
      "axis": "quantisation",
      "desc": "A random rotation followed by 1-bit quantisation with an unbiased distance estimator, so a single 1-bit code both routes and ranks (Gao & Long, 2024)."
    },
    "matryoshka": {
      "axis": "projection",
      "desc": "Truncate a Matryoshka-trained embedding to its leading dimensions: fewer dimensions at full float precision (Kusupati et al., 2022)."
    },
    "pca": {
      "axis": "projection",
      "desc": "Project onto the top principal components: the classic linear dimensionality reduction, fewer dimensions at float precision."
    },
    "Exact (flat)": {
      "axis": "organisation",
      "desc": "Brute-force exact search over full-precision vectors: the recall ceiling and, at scale, the throughput floor."
    },
    "HNSW": {
      "axis": "organisation",
      "desc": "A hierarchical navigable small-world graph. Stores the full vectors plus a graph, so it adds bytes but buys very high query throughput (Malkov & Yashunin, 2020)."
    },
    "IVF-PQ": {
      "axis": "organisation",
      "desc": "An inverted file over coarse centroids with product-quantised residuals: an order-of-magnitude smaller footprint at lower recall (Jegou et al., 2011)."
    },
    "ITQ+rerank": {
      "axis": "quantisation",
      "desc": "Iterative-quantisation binary codes (16 bytes) with full-precision re-ranking of a Hamming shortlist (Gong et al., 2011)."
    },
    "bittrie": {
      "axis": "quantisation",
      "desc": "A van Emde Boas / PATRICIA radix-trie over compact sign-codes: the sorted code array is the trie, searched coarse-to-fine, then re-ranked. Routes on an 8-byte code, reaching graph-class recall at a fraction of a graph's memory (research entry; see bitbudget bench-index)."
    },
    "LSH": {
      "axis": "projection",
      "desc": "Random hyperplane projections, one sign-bit each: a data-oblivious code. The baseline the learned projections improve on (Charikar, 2002)."
    },
    "ITQ": {
      "axis": "projection",
      "desc": "Iterative Quantisation: an unsupervised learned rotation that aligns the principal axes to the binary hypercube before thresholding (Gong et al., 2011)."
    },
    "GRH": {
      "axis": "projection",
      "desc": "Graph Regularised Hashing: a signed label graph (same-class must-link, different-class cannot-link) shapes the projection, a supervised binary code (Moran & Lavrenko, 2015)."
    },
    "KSH": {
      "axis": "projection",
      "desc": "Supervised Hashing with Kernels: a kernel map to anchors whose bits are learned sequentially against a supervised similarity residue (Liu et al., 2012)."
    },
    "DPSH (deep)": {
      "axis": "projection",
      "desc": "Deep Pairwise-Supervised Hashing: a neural hash head trained with a pairwise likelihood and a quantisation penalty, coupling the projection and quantisation in one learned network (Li et al., 2016). Here a two-stage head over the same frozen features and labels as GRH/KSH."
    },
    "float16": {
      "axis": "quantisation",
      "desc": "Half precision: each coordinate as a 16-bit float (2x smaller). The cheapest, most widely deployed compression, and essentially lossless."
    },
    "int4": {
      "axis": "quantisation",
      "desc": "4-bit per-dimension scalar quantisation (15 signed levels): half the footprint of int8, an aggressive-but-not-binary operating point."
    },
    "binary-mean": {
      "axis": "quantisation",
      "desc": "1-bit sign code thresholded at the per-coordinate MEAN, not at zero. A zero threshold assumes mean-centred data (LSH assumption A1); for off-centre embeddings like e5 it wastes most bits, and re-centring the threshold recovers them (e5: 53% -> 86% of float). Where the threshold is placed can matter as much as how many bits are spent."
    }
  },
